// Prisma Schema for MJ.TALK Platform
// Syncs PostgreSQL database schema with application models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  owner_id          String            @db.Uuid
  plan              String?           @default("free")
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @default(now()) @db.Timestamptz(6)
  
  team_members      TeamMember[]
  chatbots          Chatbot[]
  notifications     Notification[]
  kb_articles       KbArticle[]
  purchase_requests PurchaseRequest[]

  @@map("organizations")
}

model TeamMember {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String       @db.Uuid
  user_id     String       @db.Uuid
  role        String?      @default("agent")
  accepted_at DateTime?    @db.Timestamptz(6)
  created_at  DateTime?    @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([org_id, user_id])
  @@map("team_members")
}

model Chatbot {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                String        @db.Uuid
  name                  String
  description           String?
  system_prompt         String?       @default("You are a helpful customer support assistant.")
  status                String?       @default("active")
  is_active             Boolean?      @default(true)
  widget_color          String?       @default("#6366f1")
  theme_color           String?       @default("#6366f1")
  avatar_url            String?
  greeting              String?
  model                 String?       @default("gpt-4-turbo")
  temperature           Float?        @default(0.7)
  pre_chat_form_enabled Boolean?      @default(false)
  collect_visitor_name  Boolean?      @default(true)
  collect_visitor_email Boolean?      @default(true)
  collect_visitor_phone Boolean?      @default(false)
  show_powered_by       Boolean?      @default(true)
  sound_notifications   Boolean?      @default(true)
  escalation_keyword    String?       @default("ESCALATE")
  allowed_domains       String[]      @default([])
  created_at            DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?     @default(now()) @db.Timestamptz(6)

  organization          Organization  @relation(fields: [org_id], references: [id], onDelete: Cascade)
  conversations         Conversation[]
  kb_articles           KbArticle[]

  @@map("chatbots")
}

model Conversation {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatbot_id              String             @db.Uuid
  visitor_name            String?
  visitor_email           String?
  assigned_agent_id       String?            @db.Uuid
  status                  String?            @default("open")
  flagged                 Boolean?           @default(false)
  priority                String?            @default("medium")
  source                  String?            @default("widget")
  subject                 String?
  session_id              String?
  page_url                String?
  browser_info            String?
  last_message_at         DateTime?          @default(now()) @db.Timestamptz(6)
  escalation_requested_at DateTime?          @db.Timestamptz(6)
  assigned_at             DateTime?          @db.Timestamptz(6)
  closed_at               DateTime?          @db.Timestamptz(6)
  created_at              DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?          @default(now()) @db.Timestamptz(6)

  chatbot                 Chatbot            @relation(fields: [chatbot_id], references: [id], onDelete: Cascade)
  messages                Message[]
  conversation_notes      ConversationNote[]
  ai_sessions             AiSession[]
  chat_events             ChatEvent[]
  typing_indicators       TypingIndicator[]

  @@map("conversations")
}

model Message {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  role            String        @map("role")
  sender_id       String?       @db.Uuid
  content         String
  message_type    String?       @default("text")
  is_seen         Boolean?      @default(false)
  delivery_status String?       @default("sent")
  metadata        Json?         @default("{}")
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?     @default(now()) @db.Timestamptz(6)

  conversation    Conversation  @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@map("messages")
}

model Notification {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String        @db.Uuid
  target_user_id String?       @db.Uuid
  type           String
  message_id     String?       @db.Uuid
  priority       String?       @default("normal")
  action_url     String?
  read           Boolean?      @default(false)
  read_at        DateTime?     @db.Timestamptz(6)
  created_at     DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?     @default(now()) @db.Timestamptz(6)

  organization   Organization  @relation(fields: [org_id], references: [id], onDelete: Cascade)
  message        Message?      @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ConversationNote {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  created_by      String       @db.Uuid
  content         String
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @default(now()) @db.Timestamptz(6)

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("conversation_notes")
}

model AiSession {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id     String       @db.Uuid
  model               String?
  tokens_used         Int?
  cost                Decimal?     @db.Decimal
  detected_intent     String?
  intent_label        String?
  intent_confidence   Decimal?     @db.Decimal(3, 2)
  ai_confidence_score Decimal?     @db.Decimal(3, 2)
  escalated_to_human  Boolean?     @default(false)
  escalation_reason   String?
  ai_summary          String?
  handoff_summary      String?
  kb_articles_used    String[]     @default([])
  created_at          DateTime?    @default(now()) @db.Timestamptz(6)

  conversation        Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("ai_sessions")
}

model ChatEvent {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  event_type      String
  event_data      Json?
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("chat_events")
}

model KbArticle {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatbot_id   String       @db.Uuid
  org_id       String       @db.Uuid
  title        String
  content      String
  category     String?      @default("general")
  tags         String[]     @default([])
  is_published Boolean?     @default(true)
  created_by   String?      @db.Uuid
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?    @default(now()) @db.Timestamptz(6)

  chatbot      Chatbot      @relation(fields: [chatbot_id], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@map("kb_articles")
}

model Profile {
  id         String    @id @db.Uuid
  email      String    @unique
  full_name  String?
  role       String?   @default("customer")
  status     String?   @default("active")
  avatar_url String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("profiles")
}

model AgentStatus {
  agent_id             String    @id @db.Uuid
  online_status        String?   @default("offline")
  last_active          DateTime? @default(now()) @db.Timestamptz(6)
  active_chat_count    Int?      @default(0)
  max_concurrent_chats Int?      @default(5)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  @@map("agent_status")
}

model TypingIndicator {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  user_id         String?      @db.Uuid
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  expires_at      DateTime?    @default(now()) @db.Timestamptz(6)

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("typing_indicators")
}

model PurchaseRequest {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id          String       @db.Uuid
  user_id         String       @db.Uuid
  plan            String
  status          String?      @default("pending")
  request_details Json?        @default("{}")
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @default(now()) @db.Timestamptz(6)

  organization    Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@map("purchase_requests")
}
